# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-gyp's build directory
build/Release

# Small temporary files or lockfiles
.lock-wscript

# Dependency directories
node_modules/
jspm_packages/

# TypeScript v1.x command line compiler temporary targets
tests/*.js
tests/*.d.ts

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# parcel-cache
.cache
.parcel-cache

# Next.js build images and static files
.next
out

# Nuxt.js build and generate files
.nuxt
dist

# Gatsby files
.cache/
# Comment in the public line in Gatsby projects if you want to exclude Gatsby's development site from being tracked
# public

# vuepress build output
.vuepress/dist

# Serverless Webpack directories
.webpack/

# Service-sidecar files
.svelte-kit

# IDEs and editors
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# NestJS build output
dist/

# Vite build and cache outputs
dist/
.vite/

# Large local datasets (ignore the massive JSON file to avoid git bloat)
public/data.json*
src/public/data.json*
